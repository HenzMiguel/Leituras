{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "generate-env": "node ./scripts/generate-env.mjs",
    "ng": "ng",
    "prestart": "npm run generate-env",
    "start": "ng serve",
    "prebuild": "npm run generate-env",
    "build": "ng build",
    "watch": "npm run generate-env && ng build --watch --configuration development",
    "pretest": "npm run generate-env",
    "test": "ng test --watch=false",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.6",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "daisyui": "^5.7.22",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
